# Copy to .env locally if your runner loads dotenv files. Never commit .env.
# Prefer GEMINI_API_KEY; GOOGLE_API_KEY is supported only as a backwards-compatible fallback.
GEMINI_API_KEY=

# Optional non-secret configuration. Change only to a model enabled for your key/project.
GREENOPS_GEMINI_MODEL=gemini-2.5-flash
GREENOPS_GEMINI_PROJECT_LABEL=
